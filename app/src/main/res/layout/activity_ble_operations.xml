<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground"
    tools:context=".BleOperationsActivity">

    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@android:color/white"
            android:textSize="30sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/connection_card"
        android:layout_width="0dp"
        android:layout_height="132dp"
        android:layout_margin="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/connected_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Connected to: Track Tail" />

                <TextView
                    android:id="@+id/connected_device_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    tools:text="MAC: AA:BB:CC:DD:EE:FF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/connected"
                    android:textColor="@color/connectedGreen"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="▣  82%"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/main_tab"
                style="@style/TrackTailTab"
                android:text="@string/main_tab" />

            <TextView
                android:id="@+id/raw_data_tab"
                style="@style/TrackTailTab"
                android:text="@string/raw_data_tab" />

            <TextView
                android:id="@+id/raw_conf_data_tab"
                style="@style/TrackTailTab"
                android:text="@string/raw_conf_data_tab" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/connection_card">

        <ScrollView
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/heart_rate_row"
                    layout="@layout/row_dashboard_template" />
                <include
                    android:id="@+id/steps_row"
                    layout="@layout/row_dashboard_template" />
                <include
                    android:id="@+id/temperature_row"
                    layout="@layout/row_dashboard_template" />
                <include
                    android:id="@+id/battery_row"
                    layout="@layout/row_dashboard_template" />
                <include
                    android:id="@+id/accelerometer_row"
                    layout="@layout/row_dashboard_template" />
                <include
                    android:id="@+id/gps_row"
                    layout="@layout/row_dashboard_template" />
                <include
                    android:id="@+id/wifi_row"
                    layout="@layout/row_dashboard_template" />
                <include
                    android:id="@+id/updated_row"
                    layout="@layout/row_dashboard_template" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/raw_data_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/raw_data_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:id="@+id/raw_data_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/rawDataGreen"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    tools:text="@string/sample_raw_data" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/clear_button"
                    style="@style/TrackTailBottomAction"
                    android:text="♲&#10;CLEAR" />

                <TextView
                    android:id="@+id/pause_button"
                    style="@style/TrackTailBottomAction"
                    android:text="Ⅱ&#10;PAUSE" />

                <TextView
                    android:id="@+id/save_log_button"
                    style="@style/TrackTailBottomAction"
                    android:text="⇩&#10;SAVE LOG" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/raw_conf_data_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/raw_conf_data_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:id="@+id/raw_conf_data_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/rawDataGreen"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/conf_clear_button"
                    style="@style/TrackTailBottomAction"
                    android:text="♲&#10;CLEAR" />

                <TextView
                    android:id="@+id/conf_pause_button"
                    style="@style/TrackTailBottomAction"
                    android:text="Ⅱ&#10;PAUSE" />

                <TextView
                    android:id="@+id/conf_save_log_button"
                    style="@style/TrackTailBottomAction"
                    android:text="⇩&#10;SAVE LOG" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
