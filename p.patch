+    // =====================================================================
+    // Time-sync feature: phone responds to tracker's time-request notification
+    // =====================================================================
+
+    private fun startTimeSync(gatt: BluetoothGatt) {
+        val timeService = gatt.services?.firstOrNull { service ->
+            service.uuid.toString().equals(TIME_SERVICE_UUID, ignoreCase = true)
+        }
+        if (timeService == null) {
+            Timber.i("[TimeSync] Time service ($TIME_SERVICE_UUID) not found on this device")
+            return
+        }
+        Timber.i("[TimeSync] Time service found: $TIME_SERVICE_UUID")
+
+        val requestChar = timeService.characteristics?.firstOrNull { char ->
+            char.uuid.toString().equals(TIME_REQUEST_CHAR_UUID, ignoreCase = true)
+        }
+        if (requestChar == null) {
+            Timber.i("[TimeSync] Request characteristic ($TIME_REQUEST_CHAR_UUID) not found")
+            return
+        }
+        Timber.i("[TimeSync] Request characteristic found: $TIME_REQUEST_CHAR_UUID")
+
+        val responseChar = timeService.characteristics?.firstOrNull { char ->
+            char.uuid.toString().equals(TIME_RESPONSE_CHAR_UUID, ignoreCase = true)
+        }
+        if (responseChar == null) {
+            Timber.i("[TimeSync] Response characteristic ($TIME_RESPONSE_CHAR_UUID) not found")
+            return
+        }
+        Timber.i("[TimeSync] Response characteristic found: $TIME_RESPONSE_CHAR_UUID")
+
+        // Store the response char UUID so we can write to it when a request comes in
+        timeResponseCharUuid = responseChar.uuid
+
+        // Enable notifications/indications on the request characteristic
+        if (requestChar.isNotifiable() || requestChar.isIndicatable()) {
+            Timber.i("[TimeSync] Enabling notifications on request characteristic...")
+            enqueueOperation(EnableNotifications(gatt.device, requestChar.uuid))
+        } else {
+            Timber.w("[TimeSync] Request characteristic supports neither notify nor indicate")
+        }
+    }
+
+    private fun handleTimeSyncRequest(
+        gatt: BluetoothGatt,
+        characteristic: BluetoothGattCharacteristic,
+        value: ByteArray
+    ) {
+        val payload = String(value, Charsets.UTF_8)
+        Timber.i("[TimeSync] Request payload received: \"$payload\"")
+
+        if (!payload.contains("get_time")) {
+            Timber.i("[TimeSync] Payload does not request time sync; ignoring")
+            return
+        }
+
+        val responseJson = buildTimeSyncResponse()
+        Timber.i("[TimeSync] Writing response: $responseJson")
+
+        val responseCharUuid = timeResponseCharUuid
+        if (responseCharUuid == null) {
+            Timber.e("[TimeSync] Response characteristic UUID not stored; cannot write response")
+            return
+        }
+
+        val responseBytes = responseJson.toByteArray(Charsets.UTF_8)
+        enqueueOperation(
+            CharacteristicWrite(
+                device = gatt.device,
+                characteristicUuid = responseCharUuid,
+                writeType = BluetoothGattCharacteristic.WRITE_TYPE_DEFAULT,
+                payload = responseBytes
+            )
+        )
+        Timber.i("[TimeSync] Response enqueued for write")
+    }
+
+    private fun buildTimeSyncResponse(): String {
+        val ts = System.currentTimeMillis() / 1000L
+        val tz = TimeZone.getDefault().getOffset(System.currentTimeMillis()) / 60000
+        return """{"ts":$ts,"tz":$tz,"src":"Arun_Phone"}"""
+    }
